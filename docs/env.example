# Firebase (Client / Web)
# Copy this file to ../.env.local and fill in the values from Firebase Console
# Project settings → General (API, Auth Domain, Project ID, Storage Bucket, App ID)
# Project settings → Cloud Messaging → Web Push certificates (VAPID key)

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDBKDVUSmcf7qoUrDzQk1FuziGtEo_xuIc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=web-push-shop.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=web-push-shop
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=web-push-shop.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1042124125046
NEXT_PUBLIC_FIREBASE_APP_ID=1:1042124125046:web:07b684acf519982872c057
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-BZNQMF61R2

# Required for getToken() in the browser
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BKn7q_9U_kLVBMJDAMt20iJ3krJKr1AvRa1z-Ox-3CjxyA7p5q1R6K0aUjSYyFEdzHe8ioMpab--Cn-svw1nYnc

# Optional: site URL if you reference it in the app (not required for FCM)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Server (Node.js Express) – FCM v1 HTTP API
# Copy these to ../.env (root) for the Node server started via `node index.js`
# PROJECT_ID must match the Firebase project; GOOGLE_APPLICATION_CREDENTIALS
# must point to a Service Account JSON file with Firebase Admin SDK access.
# Example on Windows: C:\\path\\to\\service-account.json
# ------------------------------------------------------------
PROJECT_ID=web-push-shop
# Absolute path to service account JSON (do not commit the file)
GOOGLE_APPLICATION_CREDENTIALS= 
